{
  "name": "cht-font-preview",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node scripts/verify-assets.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:fonts": "FONT_SMOKE=1 playwright test tests/fonts.spec.ts --project=chromium",
    "assets:restore": "node scripts/restore-assets.mjs",
    "assets:fonts": "python3 scripts/build-font-assets.py"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
